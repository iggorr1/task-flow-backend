# Database
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/taskflow
SPRING_DATASOURCE_USERNAME=taskflow_user
SPRING_DATASOURCE_PASSWORD=change_me

# JWT
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# OAuth2 / Google login
FRONTEND_URL=https://wwwho.lol
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Cloudflare Turnstile captcha
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret

# Cloudflare
CLOUDFLARED_TOKEN=replace_with_cloudflare_tunnel_token
